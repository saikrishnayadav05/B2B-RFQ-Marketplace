# Recommended: free cloud PostgreSQL (Neon / Railway / Supabase)
# Sign up at https://neon.tech and paste your connection string below.
# Add ?sslmode=require at the end if your provider requires SSL.
DATABASE_URL=postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local-only fallback (Docker or local PostgreSQL)
# DATABASE_URL=postgresql://rfq_user:rfq_password@localhost:5432/rfq_marketplace

JWT_SECRET=change-this-secret-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Local dev origins (add your Vercel URL when deploying)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
